<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive hidden files like .env
    RewriteRule ^\.(.*) - [F,L]

    # Prevent access to core folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # Route all traffic seamlessly into public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
